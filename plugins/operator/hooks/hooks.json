{
  "hooks": {
    "SessionStart": [{ "hooks": [
      { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/sessionstart/inject-readme.sh" },
      { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/sessionstart/inject-log.sh" },
      { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/sessionstart/inject-changes.sh" },
      { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/sessionstart/inject-support.sh" }
    ] }],

    "Stop": [{ "hooks": [
      { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/stop/retardify-output.sh" },
      { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/stop/synthesize-log.sh" }
    ] }],

    "PreToolUse": [{ "matcher": "Bash", "hooks": [
      { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pretooluse/block-protected-paths.sh" },
      { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pretooluse/block-destructive-git.sh" },
      { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pretooluse/block-outside-moves.sh" },
      { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pretooluse/suggest-allow-rules.sh" }
    ] }],

    "PostToolUse": [{ "matcher": "Write|Edit", "hooks": [
      { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/posttooluse/eslint.sh", "timeout": 120 },
      { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/posttooluse/retardify-code.sh", "timeout": 120 },
      { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/posttooluse/retardify-file.sh", "timeout": 120 }
    ] }],

    "TaskCompleted": [{ "hooks": [
      { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/taskcompleted/append-log.sh" }
    ] }]
  }
}
