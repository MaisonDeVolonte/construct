/**
 * =======================================================
 * @file settings.managed.jsonc - the sudo scope kept bare
 * =======================================================
 * @description
 * - copy to /Library/Application Support/ClaudeCode/managed-settings.json
 * - the only scope needing sudo, so it carries nothing unproven
 * - the floor, credentials and booleans sit in settings.user.jsonc until they run clean
 * - any scope's deny binds as hard as one here (no scope's deny can remove another's)
 * - WHAT ONLY THIS SCOPE CAN DO
 *   - `filesystem.allowManagedReadPathsOnly` honors managed allowRead alone; denies still merge
 *   - `allowManagedDomainsOnly` honors managed allowedDomains alone
 *   - `credentials.envVars` may use `mask`, which project and local scopes cannot
 *   - pins `filesystem.disabled`, so no lower scope can drop the filesystem layer
 *     - any `sandbox.filesystem` or `credentials.files` block here activates that pin
 *     - unpinned, the key is settable from user settings or a --settings flag
 *     - CLAUDE_CODE_SUBPROCESS_ENV_SCRUB outranks even this file
 * - WHAT MUST NEVER GO HERE, AT ANY VALUE (managed wins booleans, so a stated default pins it)
 *   - `allowUnsandboxedCommands` belongs in project, where an unattended repo sets it false
 *   - `failIfUnavailable` belongs in user, where a lockout needs an editor rather than sudo
 * - verify with /sandbox Config, the only place this file's effect shows up merged
 * @see AGENTS.md, AGENTS/settings/
 */

{
  "sandbox": {
    "enabled": true,
    "allowManagedDomainsOnly": false,
    "filesystem": {
      "allowManagedReadPathsOnly": false,
      "disabled": false
    }
  }
}
