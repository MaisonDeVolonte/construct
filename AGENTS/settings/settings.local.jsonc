/**
 * =======================================================
 * @file settings.local.jsonc - hooks and temporary grants
 * =======================================================
 * @description
 * - copy to .claude/settings.local.json
 * - gitignored, so hooks here vanish on a fresh clone
 * - the right home for a temporary grant, since nothing here is committed
 * - mechanics live in README.md
 * - this block covers only why these values
 * - `enabled` restated so this checkout stays sandboxed on its own
 * - `ask` on dangerouslyDisableSandbox makes each escape visible
 * - `hooks` is the real payload, and nothing else belongs in this scope
 *   - `PreToolUse` runs before every rule, vetoing what an allow would pass
 *   - `PostToolUse` matches Write and Edit only, and never blocks
 * - every `Always Allow` click lands here as an allow rule
 * - a grant here is an ordinary allow, so any deny or ask still beats it
 * @see AGENTS.md, README.md, AGENTS/settings/, AGENTS/hooks/
 */

{
  "sandbox": { "enabled": true },

  "permissions": { "ask": [ "Bash(dangerouslyDisableSandbox:true)" ] },

  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "AGENTS/hooks/sessionstart.sh" }] }],
    "PreToolUse": [{ "matcher": "Bash", "hooks": [{ "type": "command", "command": "AGENTS/hooks/pretooluse.sh" }] }],
    "PostToolUse": [{ "matcher": "Write|Edit", "hooks": [{ "type": "command", "command": "AGENTS/hooks/posttooluse.sh", "timeout": 120 }] }],
    "TaskCreated": [{ "hooks": [{ "type": "command", "command": "AGENTS/hooks/taskcreated.sh" }] }],
    "TaskCompleted": [{ "hooks": [{ "type": "command", "command": "AGENTS/hooks/taskcompleted.sh" }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "AGENTS/hooks/stop.sh" }] }]
  }
}
