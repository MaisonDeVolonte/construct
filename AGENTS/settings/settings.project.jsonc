/**
 * =====================================================
 * @file settings.project.jsonc - the floor that travels
 * =====================================================
 * @description
 * - copy to .claude/settings.json
 * - committed, so this is the only scope a clone carries
 * - mechanics live in README.md
 * - this block covers only why these values
 * - SANDBOX
 *   - `enabled` restated so a fresh clone is sandboxed before any managed file exists
 *   - `excludedCommands` holds gh alone, a go cli that fails tls under seatbelt
 *   - it never reaches gh inside a sidecar, which runs as a sandboxed child
 *   - `allowedDomains` repeats user so the egress travels with the clone
 * - PERMISSIONS
 *   - `deny` mirrors the user floor verbatim, since a clone may land with no floor above it
 *   - `generated` is the one block user does not carry, being repo-shaped
 *   - `ask` on dangerouslyDisableSandbox makes each escape visible
 *   - `allow` on the sidecars covers regular-permissions mode
 *   - the `.sh*` tail matches arguments, which a bare `.sh` silently did not
 *   - `Bash(gh *)` pairs with the exclusion above, destructive gh denies staying in the floor
 *   - `Bash(npx *)` is allowed, so remote packages run without a prompt
 *   - `WebFetch` names only the docs hosts this repo fetches
 *   - no build-tool allows, since sandboxed commands auto-approve anyway
 *   - this scope cannot set `filesystem.disabled`, by design
 * @see AGENTS.md, README.md, AGENTS/settings/, AGENTS/hooks/pretooluse.sh
 */

{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": true,

    "excludedCommands": [],

    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "registry.npmjs.org"
      ]
    }
  },

  "permissions": {
    "ask": [ "Bash(dangerouslyDisableSandbox:true)" ],

    "deny": [
      "Write(~/.claude/**)", "Edit(~/.claude/**)",
      "Write(.claude/**)", "Edit(.claude/**)",

      "Bash(sudo *)",
      "Bash(mkfs*)", "Bash(dd *)",
      "Bash(rm -rf *)", "Bash(rm -fr *)", "Bash(rm -R *)", "Bash(rm -r *)",
      "Bash(chmod -R *)", "Bash(chown -R *)",

      "Bash(eval *)",
      "Bash(node -e *)", "Bash(node --eval *)",
      "Bash(python -c *)", "Bash(python3 -c *)",
      "Bash(perl -e *)", "Bash(ruby -e *)",
      "Bash(curl * | bash)", "Bash(curl * | sh)", "Bash(curl * | python*)",
      "Bash(wget * | bash)", "Bash(wget * | sh)", "Bash(wget * | python*)",
      "Bash(*fs.rm*)", "Bash(*fs.unlink*)", "Bash(*fs.rmdir*)", "Bash(*rimraf*)",

      "Bash(gh repo delete*)", "Bash(gh repo archive*)", "Bash(gh release delete*)",
      "Bash(gh auth *)", "Bash(gh ssh-key *)", "Bash(gh gpg-key *)",
      "Bash(gh secret *)", "Bash(gh variable *)",
      "Bash(git push --mirror*)", "Bash(git push * --mirror*)",
      "Bash(git push --prune*)", "Bash(git push * --prune*)",
      "Bash(git push --delete*)", "Bash(git push * --delete*)",
      "Bash(git push --force*)", "Bash(git push -f*)",
      "Bash(git push * --force*)", "Bash(git push * -f*)",
      "Bash(git push origin main*)", "Bash(git push origin master*)",

      "Bash(dropdb *)", "Bash(db:drop*)", "Bash(prisma migrate reset*)",

      "Bash(git filter-branch*)", "Bash(git reflog expire*)",
      "Bash(git update-ref -d*)", "Bash(git gc --prune*)",
      "Bash(git branch -D*)", "Bash(git branch * -D*)",
      "Bash(git branch -f*)", "Bash(git branch * -f*)",
      "Bash(git branch --force*)", "Bash(git branch --delete --force*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -f*)", "Bash(git checkout --force*)",
      "Bash(git clean -f*)", "Bash(git clean -d*)", "Bash(git clean -x*)", "Bash(git clean * -f*)",
      "Bash(git stash clear*)", "Bash(git stash drop*)",

      "Read(//**/.env*)", "Write(//**/.env*)", "Edit(//**/.env*)",
      "Read(~/**/*.pem)", "Read(~/**/*.crt)", "Read(//**/*.key)", "Read(//**/*.p12)",
      "Read(~/.ssh/**)", "Read(~/.aws/**)", "Read(~/.config/gcloud/**)", "Read(~/.kube/**)",
      "Read(~/.gnupg/**)", "Read(~/.netrc)", "Read(~/.npmrc)",
      "Read(~/.bash_history)", "Read(~/.zsh_history)",
      "Read(~/Library/Keychains/**)",

      "Edit(**/.git/**)", "Write(**/.git/**)",
      "Edit(**/.husky/**)", "Write(**/.husky/**)",
      "Edit(**/.devin/**)", "Write(**/.devin/**)",
      "Edit(**/.cursor/**)", "Write(**/.cursor/**)",
      "Edit(terraform/**/*.tfstate*)", "Write(terraform/**/*.tfstate*)",
      "Edit(**/*docker-compose.prod*)", "Write(**/*docker-compose.prod*)",
      "Edit(webflow/**)", "Write(webflow/**)"
    ],

    "allow": [
      "Write(AGENTS/**/*.md)", "Edit(AGENTS/**/*.md)",
      "Write(docs/**)", "Edit(docs/**)",

      "Bash(AGENTS/git/*.sh*)", "Bash(AGENTS/hooks/*.sh*)",
      "Bash(AGENTS/templates/*.sh*)", "Bash(AGENTS/security/*.sh*)",

      "Bash(gh *)", "Bash(npx *)",

      "WebFetch(domain:code.claude.com)", "WebFetch(domain:docs.claude.com)"
    ]
  }
}
