/**
 * =====================================================
 * @file settings.project.jsonc - the floor that travels
 * =====================================================
 * @description
 * - copy to .claude/settings.json
 * - committed, so this is the only scope that travels with a clone
 * - the deny floor and the npx ask are verbatim copies of managed, on purpose: a clone lands
 *   on machines with no ceiling installed, and this file is the ceiling that travels
 * - `generated` is the one block managed does not carry: those paths are repo-shaped, so they
 *   travel with the clone rather than sitting in a machine file that may never see this repo
 * - [enabled: true] so a fresh clone is sandboxed even before any managed file exists
 * - no build-tool allows (npm, pnpm, node, tsc, eslint): sandboxed commands auto-approve, so
 *   those rules did nothing but widen the unsandboxed fallback; the sandbox is the grant
 * - npx stays on ask in every scope, since it fetches and executes remote packages, and a
 *   scoped ask forces a prompt even for sandboxed commands
 * - sidecar allows cover regular-permissions mode, where sandboxed commands still prompt;
 *   the `.sh*` tail matches arguments too, which the old bare `.sh` form silently did not
 * - gh is the one excludedCommands entry: a Go CLI that fails TLS under Seatbelt, so it runs
 *   unsandboxed through the permission flow: broad allow here, destructive denies in the
 *   floor above, and pretooluse.sh as the backstop reading the whole command string
 * - WebFetch is narrowed to the docs domains this repo actually fetches; each domain allow
 *   also seeds the sandbox bash allowlist, which is why the bare form had to go
 * - allowedDomains is the sandboxed-bash egress: github.com for the https remote, api.github.com
 *   because gh inside a sidecar is a sandboxed child the exclusion above never reaches, and the
 *   npm registry for the day this repo gains a package.json; unlisted domains prompt
 * - cannot set `filesystem.disabled`, by design; a checked-out project can never switch
 *   isolation off, and only managed can, since its credentials block pins the key there
 * @see AGENTS.md, AGENTS/settings/settings.managed.jsonc, AGENTS/settings/settings.user.jsonc,
 *      AGENTS/settings/settings.local.jsonc, AGENTS/hooks/pretooluse.sh
 */

{
  "sandbox": {
    "enabled": true,
    "excludedCommands": [
      "gh *"
    ],
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "registry.npmjs.org"
      ]
    }
  },
  "permissions": {
    "deny": [
      "Write(~/.claude/**)", "Edit(~/.claude/**)",
      "Write(.claude/**)", "Edit(.claude/**)",

      "Bash(sudo *)",
      "Bash(mkfs*)", "Bash(dd *)",
      "Bash(rm -rf *)", "Bash(rm -fr *)", "Bash(rm -R *)", "Bash(rm -r *)",
      "Bash(chmod -R *)", "Bash(chown -R *)",

      "Bash(eval *)",
      "Bash(node -e *)", "Bash(node --eval *)",
      "Bash(python -c *)", "Bash(python3 -c *)",
      "Bash(perl -e *)", "Bash(ruby -e *)",
      "Bash(curl * | bash)", "Bash(curl * | sh)", "Bash(curl * | python*)",
      "Bash(wget * | bash)", "Bash(wget * | sh)", "Bash(wget * | python*)",
      "Bash(*fs.rm*)", "Bash(*fs.unlink*)", "Bash(*fs.rmdir*)", "Bash(*rimraf*)",

      "Bash(gh repo delete*)", "Bash(gh repo archive*)", "Bash(gh release delete*)",
      "Bash(gh auth *)", "Bash(gh ssh-key *)", "Bash(gh gpg-key *)",
      "Bash(gh secret *)", "Bash(gh variable *)",
      "Bash(git push --mirror*)", "Bash(git push * --mirror*)",
      "Bash(git push --prune*)", "Bash(git push * --prune*)",
      "Bash(git push --delete*)", "Bash(git push * --delete*)",
      "Bash(git push --force*)", "Bash(git push -f*)",
      "Bash(git push * --force*)", "Bash(git push * -f*)",
      "Bash(git push origin main*)", "Bash(git push origin master*)",

      "Bash(dropdb *)", "Bash(db:drop*)", "Bash(prisma migrate reset*)",

      "Bash(git filter-branch*)", "Bash(git reflog expire*)",
      "Bash(git update-ref -d*)", "Bash(git gc --prune*)",
      "Bash(git branch -D*)", "Bash(git branch * -D*)",
      "Bash(git branch -f*)", "Bash(git branch * -f*)",
      "Bash(git branch --force*)", "Bash(git branch --delete --force*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -f*)", "Bash(git checkout --force*)",
      "Bash(git clean -f*)", "Bash(git clean -d*)", "Bash(git clean -x*)", "Bash(git clean * -f*)",
      "Bash(git stash clear*)", "Bash(git stash drop*)",

      "Read(**/.env*)", "Write(**/.env*)", "Edit(**/.env*)",
      "Read(//**/*.pem)", "Read(//**/*.key)", "Read(//**/*.p12)", "Read(//**/*.crt)",
      "Read(~/.ssh/**)", "Read(~/.aws/**)", "Read(~/.config/gcloud/**)", "Read(~/.kube/**)",
      "Read(~/.gnupg/**)", "Read(~/.netrc)", "Read(~/.npmrc)",
      "Read(~/.bash_history)", "Read(~/.zsh_history)",
      "Read(~/Library/Keychains/**)",

      "Edit(**/.git/**)", "Write(**/.git/**)",
      "Edit(**/.husky/**)", "Write(**/.husky/**)",
      "Edit(**/.devin/**)", "Write(**/.devin/**)",
      "Edit(**/.cursor/**)", "Write(**/.cursor/**)",
      "Edit(terraform/**/*.tfstate*)", "Write(terraform/**/*.tfstate*)",
      "Edit(**/*docker-compose.prod*)", "Write(**/*docker-compose.prod*)",
      "Edit(webflow/**)", "Write(webflow/**)"
    ],
    "ask": [
      "Bash(npx *)"
    ],
    "allow": [
      "Write(AGENTS/**/*.md)", "Edit(AGENTS/**/*.md)",
      "Write(docs/**)", "Edit(docs/**)",

      "Bash(AGENTS/git/*.sh*)", "Bash(AGENTS/hooks/*.sh*)",
      "Bash(AGENTS/templates/*.sh*)", "Bash(AGENTS/security/*.sh*)",

      "Bash(gh *)",

      "WebFetch(domain:code.claude.com)", "WebFetch(domain:docs.claude.com)"
    ]
  }
}
